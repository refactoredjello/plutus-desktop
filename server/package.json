{
  "name": "plutus-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./app": { "plutus-source": "./src/app.ts", "default": "./dist/app.js" },
    "./config": { "plutus-source": "./src/config.ts", "default": "./dist/config.js" },
    "./db": { "plutus-source": "./src/db/index.ts", "default": "./dist/db/index.js" },
    "./log": { "plutus-source": "./src/lib/log.ts", "default": "./dist/lib/log.js" },
    "./scheduler": { "plutus-source": "./src/scheduler.ts", "default": "./dist/scheduler.js" },
    "./secrets": { "plutus-source": "./src/secrets.ts", "default": "./dist/secrets.js" },
    "./settings": { "plutus-source": "./src/services/app_settings.ts", "default": "./dist/services/app_settings.js" },
    "./runtime-config": { "plutus-source": "./src/services/config.ts", "default": "./dist/services/config.js" },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && cp -R src/db/migrations dist/db/migrations",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test",
    "openapi": "tsx scripts/export-openapi.ts ../web/src/api/openapi.json",
    "demo": "tsx scripts/demo.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.12",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
