{
  "name": "plutus-desktop",
  "productName": "Plutus",
  "private": true,
  "version": "0.2.0",
  "description": "Plutus personal finance, as a desktop app",
  "author": "Plutus",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:all": "npm run build --prefix ../web && npm run build --prefix ../server && npm run build",
    "dev": "npm run build:all && electron .",
    "smoke": "npm run build:all && PLUTUS_SMOKE=1 node scripts/with-timeout.mjs 120 electron .",
    "dist": "npm run build:all && electron-builder --config electron-builder.config.mjs",
    "smoke:dist": "PLUTUS_SMOKE=1 node scripts/with-timeout.mjs 120 \"$(sh scripts/packaged-app.sh)\"",
    "icons": "sh scripts/icons.sh",
    "version:bump": "node scripts/version.mjs bump",
    "version:check-tag": "node scripts/version.mjs check-tag",
    "update:app": "bash scripts/update.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "plutus-server": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
