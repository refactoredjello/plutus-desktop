# Environment for the headless server (server/). Copy to .env and fill in; never commit .env.
# The server does not read the file itself: start it with `node --env-file=.env ...` (see
# README.md). The desktop app reads none of this.

# Encrypts secrets (SimpleFIN access URL, Anthropic API key) in the database. Long and random:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
PLUTUS_SECRET_KEY=change-me
# The SQLite file: PLUTUS_DB_PATH, else plutus.sqlite in PLUTUS_DATA_DIR (default ~/.plutus).
# Absolute paths: the file is not read by a shell, so ~ is not expanded.
# PLUTUS_DATA_DIR=
# PLUTUS_DB_PATH=
# The built SPA to serve (default: web/dist next to server/).
# PLUTUS_WEB_DIST=
HOST=127.0.0.1
PORT=8000
# true: /api requires the per-launch cookie, as in the desktop app.
PLUTUS_API_GUARD=false
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Runtime settings live in the database and are changed on the Settings page. A value set
# here seeds the database on first start and overrides it on every later start, so leave
# these commented out unless you want the environment to win.
# fake | claude | ollama
# LLM_PROVIDER=fake
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# Hours between scheduled syncs; an integer, at least 1.
# SYNC_INTERVAL_HOURS=6
# Days of history the first sync requests (an integer, at least 1); each 45 days is one SimpleFIN request.
# SYNC_FIRST_HISTORY_DAYS=180
# SCHEDULER_ENABLED=true
# JSON list of name fragments to scrub before anything reaches an LLM, e.g. ["ALEX","SAMPLE"]
# OWNER_NAME_TOKENS=[]
