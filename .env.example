# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
POSTGRES_PASSWORD=plutus
# Used when running the API or tests on the host instead of in Docker:
DATABASE_URL=postgresql+psycopg://plutus:plutus@localhost:5432/plutus
TEST_DATABASE_URL=postgresql+psycopg://plutus:plutus@localhost:5432/plutus_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Generate with: make password-hash. Keep the single quotes: the hash contains $ signs.
APP_PASSWORD_HASH=''

# fake | claude | ollama
LLM_PROVIDER=fake
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

SYNC_INTERVAL_HOURS=6
# Days of history the first sync requests; each 45 days is one SimpleFIN request.
SYNC_FIRST_HISTORY_DAYS=180
SCHEDULER_ENABLED=true
# JSON list of name fragments to scrub before anything reaches an LLM, e.g. ["ALEX","SAMPLE"]
OWNER_NAME_TOKENS=[]
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=info
